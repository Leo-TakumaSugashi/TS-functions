            function A = ColorShift_ButtonImage(im)
                HSV = rgb2hsv(im);
                S = HSV(:,:,2);
                V = HSV(:,:,3);
                V(S<0.3) = 0;
                HSV(:,:,3) = V;
                A = hsv2rgb(HSV);
                A = uint8(A*255);
            end
        
