            RenderingAlphaApply       = [0.3,  0.4,  0.7,   0.2];
            RenderingFaceColorEdit    = [0.0,  0.2,  0.5,   0.2];
            RenderingFaceColorApply   = [0.5,  0.2,  0.5,   0.2];
            RenderingThresholdEdit    = [0.6,  0.0,  0.4,   0.2];
            RenderingThresholdApply   = [0.0,  0.0,  0.6,   0.2];
