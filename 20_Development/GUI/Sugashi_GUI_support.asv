%             BranchEditPanel           = [0.67   0.0   0.32    0.99];
            BranchEditPanel           = [0.41   0.0   0.58    0.99];

            BranchEdit_FindAroundDist = [0.01   0.78   0.09   0.20];
            BranchEdit_DistUnit       = [0.10   0.80   0.11   0.15];
            BranchEdit_FindAroundID   = [0.22   0.78   0.35   0.21];
            BranchEdit_CheckedID      = [0.62   0.78   0.37   0.21];

            BranchEdit_Step_text      = [0.01    0.53   0.17   0.15];
            BranchEdit_Step_Edit      = [0.19    0.51   0.13   0.18];
            BranchEdit_Step_unit      = [0.33    0.53   0.11   0.15];

            BranchEdit_Xstep_m10      = [0.01   0.32   0.11   0.14];
            BranchEdit_Xstep_m1       = [0.12   0.32   0.07   0.14];
            BranchEdit_Xstep_text     = [0.19   0.33   0.06   0.14];
            BranchEdit_Xstep_p1       = [0.25   0.32   0.07   0.14];
            BranchEdit_Xstep_p10      = [0.32   0.32   0.11   0.14];

            BranchEdit_Ystep_m10      = [0.01   0.32-.15   0.11   0.14];
            BranchEdit_Ystep_m1       = [0.12   0.32-.15   0.07   0.14];
            BranchEdit_Ystep_text     = [0.19   0.33-.15   0.06   0.14];
            BranchEdit_Ystep_p1       = [0.25   0.32-.15   0.07   0.14];
            BranchEdit_Ystep_p10      = [0.32   0.32-.15   0.11   0.14];

            BranchEdit_Zstep_m10      = [0.01   0.02   0.11   0.14];
            BranchEdit_Zstep_m1       = [0.12   0.02   0.07   0.14];
            BranchEdit_Zstep_text     = [0.19   0.03   0.06   0.14];
            BranchEdit_Zstep_p1       = [0.25   0.02   0.07   0.14];
            BranchEdit_Zstep_p10      = [0.32   0.02   0.11   0.14];
            

            BranchEdit_VerticalLine   = [0.47   0.1   0.01   0.55];
            
            BranchEdit_Radius_text    = [0.56    0.53   0.17   0.14];
            BranchEdit_Radius_Edit    = [0.74    0.51   0.13   0.18];
            BranchEdit_Radius_unit    = [0.88    0.53   0.11   0.14];

            BranchEdit_Center_text    = [0.48    0.35   0.51   0.15];

            BranchEdit_Apply          = [0.50    0.05   0.21   0.22];
            BranchEdit_Cancel         = [0.73    0.05   0.27   0.24];

%             <<  <  X  >  >> | Step [0.1] um
