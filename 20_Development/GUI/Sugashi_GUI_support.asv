            H.BranchEdit_Radius_text   = uicontrol(H.BranchEditPanel,...
                'Style','text',...
                'Units','Normalized',...
                'Position',BranchEdit_Radius_text  ,...
                'String',"Radius",...
                'FontSize',obj.FontSize,...
