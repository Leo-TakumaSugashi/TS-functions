            H.BranchEdit_Ystep_p1 = uicontrol(H.BranchEditPanel,...
                'Units','Normalized',...
                'Position',BranchEdit_Ystep_p1,...
                'String',">",...
                'FontSize',obj.FontSize,...
                'BackgroundColor',[.3 .6 .6]);
           
            H.BranchEdit_Zstep_text  = uicontrol(H.BranchEditPanel,...
                'Style','text',...
                'Units','Normalized',...
                'Position',BranchEdit_Zstep_text ,...
                'String',"Z",...
                'FontSize',obj.FontSize,...
                'BackgroundColor',H.BranchEditPanel.BackgroundColor);
            H.BranchEdit_Zstep_m10 = uicontrol(H.BranchEditPanel,...
                'Units','Normalized',...
                'Position',BranchEdit_Zstep_m10,...
                'String',"<<",...
                'FontSize',obj.FontSize,...
                'BackgroundColor',[.6 .3 .6]);
            H.BranchEdit_Zstep_m1 = uicontrol(H.BranchEditPanel,...
                'Units','Normalized',...
                'Position',BranchEdit_Zstep_m1,...
                'String',"<",...
                'FontSize',obj.FontSize,...
                'BackgroundColor',[.6 .3 .6]);
            H.BranchEdit_Zstep_p10 = uicontrol(H.BranchEditPanel,...
                'Units','Normalized',...
                'Position',BranchEdit_Zstep_p10,...
                'String',">>",...
                'FontSize',obj.FontSize,...
